# 복사해서 .env 로 만들어 사용 (cp .env.example .env). .env 는 절대 커밋하지 않는다.

# --- DB (docker-compose 의 mysql 컨테이너와 동일 값) ---
DB_HOST=localhost
DB_PORT=3307
DB_NAME=cms
DB_USER=cms
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-root

# --- 앱 ---
SERVER_PORT=8081
APP_PORT=8081
UPLOAD_DIR=./uploads

# --- 관리자 시드 계정 (비워 두면 생성하지 않음) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin
# ADMIN_NAME=Admin   # 한글 값은 .env 대신 application.yml 에서 설정 (아래 참고)

# --- 브랜드 ---
# 주의: 로컬 bootRun 은 .env 를 .properties 형식(ISO-8859-1)으로 읽어 한글이 깨진다.
#       한글 문구(BRAND_TAGLINE, ADMIN_NAME 등)는 application.yml 의 기본값을 고치거나,
#       Docker/IDE 환경변수로 주입(UTF-8)하세요. 이 파일의 값은 ASCII 로 유지하는 것을 권장.
BRAND_NAME=LUMO
# BRAND_TAGLINE=...  # 한글 값은 .env 대신 application.yml 에서 설정 (아래 참고)
BRAND_LOGO_PATH=
# 폰트 프리셋 기본값: PRETENDARD | NANUM_GOTHIC | NANUM_SQUARE_ROUND | NOTO_SANS_KR | IBM_PLEX_SANS_KR
BRAND_FONT_PRESET=PRETENDARD
BRAND_PRIMARY_COLOR=#4E90C4
BRAND_BACKGROUND_COLOR=#F7FBFE
BRAND_COMPANY=LUMO Inc.
BRAND_CONTACT_EMAIL=help@example.com
SHIPPING_FEE=3000
FREE_SHIPPING_OVER=50000

# --- 포트원(아임포트) V1: 기본은 공개 테스트 식별코드. 실제 키는 발급 후 입력 ---
PORTONE_IMP_CODE=imp00000000
PORTONE_PG=html5_inicis
PORTONE_API_KEY=
PORTONE_API_SECRET=
PORTONE_VERIFY_ENABLED=false
